<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CatalogoCursosShell.Views.DetalleCursoPage"
             Title="Detalle del Curso"
             BackgroundColor="{AppThemeBinding Light=#F4F6F9, Dark=#121214}">

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="20">

            <!-- Encabezado del Curso -->
            <Border StrokeThickness="0"
                    StrokeShape="RoundRectangle 16"
                    BackgroundColor="#512BD4"
                    Padding="24">
                <VerticalStackLayout Spacing="10">
                    <HorizontalStackLayout Spacing="8">
                        <Border StrokeThickness="0"
                                StrokeShape="RoundRectangle 8"
                                BackgroundColor="#3D1D9F"
                                Padding="8,4">
                            <Label x:Name="lblBadgeId"
                                   Text="ID: #0"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="#EDE7F6" />
                        </Border>
                        <Border StrokeThickness="0"
                                StrokeShape="RoundRectangle 8"
                                BackgroundColor="#004D40"
                                Padding="10,4">
                            <Label x:Name="lblBadgeCreditos"
                                   Text="0 Créditos"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="#A7FFEB" />
                        </Border>
                    </HorizontalStackLayout>

                    <Label x:Name="lblNombreCurso"
                           Text="Nombre del Curso"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="White" />
                </VerticalStackLayout>
            </Border>

            <!-- Tarjeta: Información del Docente -->
            <Border StrokeThickness="1"
                    Stroke="{AppThemeBinding Light=#E5E7EB, Dark=#27272A}"
                    StrokeShape="RoundRectangle 14"
                    BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E24}"
                    Padding="18">
                <HorizontalStackLayout Spacing="14" VerticalOptions="Center">
                    <Border StrokeThickness="0"
                            StrokeShape="RoundRectangle 12"
                            BackgroundColor="#EDE7F6"
                            HeightRequest="52"
                            WidthRequest="52"
                            HorizontalOptions="Center"
                            VerticalOptions="Center">
                        <Label Text="👨‍🏫"
                               FontSize="26"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                        <Label Text="Docente Asignado"
                               FontSize="12"
                               TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}"
                               FontAttributes="Bold" />
                        <Label x:Name="lblDocente"
                               Text="Nombre del Docente"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#111827, Dark=#F9FAFB}" />
                    </VerticalStackLayout>
                </HorizontalStackLayout>
            </Border>

            <!-- Tarjeta: Descripción Completa -->
            <Border StrokeThickness="1"
                    Stroke="{AppThemeBinding Light=#E5E7EB, Dark=#27272A}"
                    StrokeShape="RoundRectangle 14"
                    BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E24}"
                    Padding="18">
                <VerticalStackLayout Spacing="10">
                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                        <Label Text="📝" FontSize="18" VerticalOptions="Center" />
                        <Label Text="Descripción del Programa"
                               FontSize="15"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#111827, Dark=#F9FAFB}"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <Label x:Name="lblDescripcion"
                           Text="Contenido y objetivos del curso..."
                           FontSize="14"
                           TextColor="{AppThemeBinding Light=#4B5563, Dark=#D1D5DB}"
                           LineHeight="1.3" />
                </VerticalStackLayout>
            </Border>

            <!-- Botones de Acción -->
            <VerticalStackLayout Spacing="12" Margin="0,10,0,0">
                <Button Text="✏️ Editar Curso"
                        BackgroundColor="#512BD4"
                        TextColor="White"
                        FontAttributes="Bold"
                        FontSize="15"
                        CornerRadius="12"
                        HeightRequest="48"
                        Clicked="OnEditarCursoClicked" />

                <Button Text="Volver al Catálogo"
                        BackgroundColor="Transparent"
                        TextColor="{AppThemeBinding Light=#512BD4, Dark=#9E86EB}"
                        BorderColor="{AppThemeBinding Light=#512BD4, Dark=#9E86EB}"
                        BorderWidth="1.5"
                        FontAttributes="Bold"
                        FontSize="14"
                        CornerRadius="12"
                        HeightRequest="46"
                        Clicked="OnVolverClicked" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
