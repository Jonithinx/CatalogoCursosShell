<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CatalogoCursosShell.Views.AcercaPage"
             Title="Acerca de"
             BackgroundColor="{AppThemeBinding Light=#F4F6F9, Dark=#121214}">

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="20">

            <!-- Banner / Cabecera -->
            <Border StrokeThickness="0"
                    StrokeShape="RoundRectangle 16"
                    BackgroundColor="#512BD4"
                    Padding="24">
                <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                    <Border StrokeThickness="2"
                            Stroke="#EDE7F6"
                            StrokeShape="RoundRectangle 36"
                            HeightRequest="72"
                            WidthRequest="72"
                            BackgroundColor="#673AB7"
                            HorizontalOptions="Center">
                        <Label Text="🎓"
                               FontSize="36"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>

                    <Label Text="Catálogo de Cursos"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalOptions="Center" />

                    <Label Text="Versión 1.0.0"
                           FontSize="12"
                           TextColor="#D1C4E9"
                           FontAttributes="Bold"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>

            <!-- Tarjeta: Propósito y Descripción -->
            <Border StrokeThickness="1"
                    Stroke="{AppThemeBinding Light=#E5E7EB, Dark=#27272A}"
                    StrokeShape="RoundRectangle 14"
                    BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E24}"
                    Padding="18">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Presentación 4 – Navegación con Shell"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#111827, Dark=#F9FAFB}" />
                    <Label Text="Aplicación móvil desarrollada en .NET MAUI para demostrar la implementación integral de .NET MAUI Shell, incluyendo menús Flyout laterales, navegación por pestañas (TabBar), navegación basada en URI con GoToAsync, paso de parámetros primitivos por Query String y transferencia de objetos complejos mediante IQueryAttributable."
                           FontSize="13"
                           TextColor="{AppThemeBinding Light=#4B5563, Dark=#D1D5DB}"
                           LineHeight="1.3" />
                </VerticalStackLayout>
            </Border>

            <!-- Tarjeta: Tecnologías Empleadas -->
            <Border StrokeThickness="1"
                    Stroke="{AppThemeBinding Light=#E5E7EB, Dark=#27272A}"
                    StrokeShape="RoundRectangle 14"
                    BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E24}"
                    Padding="18">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Tecnologías y Patrones"
                           FontSize="15"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#111827, Dark=#F9FAFB}" />

                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12" RowSpacing="10">
                        <Label Grid.Row="0" Grid.Column="0" Text="🟣" FontSize="14" />
                        <Label Grid.Row="0" Grid.Column="1" Text=".NET 10 / .NET MAUI" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1F2937, Dark=#F9FAFB}" />

                        <Label Grid.Row="1" Grid.Column="0" Text="🔷" FontSize="14" />
                        <Label Grid.Row="1" Grid.Column="1" Text="C# 13 &amp; XAML" FontSize="13" TextColor="{AppThemeBinding Light=#4B5563, Dark=#D1D5DB}" />

                        <Label Grid.Row="2" Grid.Column="0" Text="🧭" FontSize="14" />
                        <Label Grid.Row="2" Grid.Column="1" Text="Shell Navigation (Flyout, TabBar, Routing)" FontSize="13" TextColor="{AppThemeBinding Light=#4B5563, Dark=#D1D5DB}" />

                        <Label Grid.Row="3" Grid.Column="0" Text="🔄" FontSize="14" />
                        <Label Grid.Row="3" Grid.Column="1" Text="QueryProperty &amp; IQueryAttributable" FontSize="13" TextColor="{AppThemeBinding Light=#4B5563, Dark=#D1D5DB}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Derechos y Créditos -->
            <Label Text="Desarrollado para la Cátedra de Programación Móvil © 2026"
                   FontSize="12"
                   TextColor="{AppThemeBinding Light=#9CA3AF, Dark=#6B7280}"
                   HorizontalOptions="Center" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
